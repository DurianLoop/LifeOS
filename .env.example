# LifeOS · local app / BYOK AI
# Copy to .env locally. Never commit .env or real credentials.
LIFEOS_HOST=127.0.0.1
LIFEOS_PORT=8787
LIFEOS_LLM_API_KEY=
LIFEOS_LLM_BASE_URL=https://api.deepseek.com
LIFEOS_LLM_MODEL=deepseek-v4-flash

# Optional Local/OpenAI-compatible model endpoint.
# In LifeOS Privacy Center choose Local and point the provider at your local server.
LIFEOS_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LIFEOS_LOCAL_LLM_MODEL=

# Reference Cloud / Web Companion (development defaults are local only).
LIFEOS_CLOUD_HOST=127.0.0.1
LIFEOS_CLOUD_PORT=8790
LIFEOS_CLOUD_DB=

# Optional LifeOS Cloud AI gateway. Keep the key only on the cloud server.
LIFEOS_CLOUD_AI_PROVIDER=mock
LIFEOS_CLOUD_AI_BASE_URL=
LIFEOS_CLOUD_AI_MODEL=
LIFEOS_CLOUD_AI_API_KEY=

# Optional Stripe billing adapter. Production also needs the signed webhook.
LIFEOS_STRIPE_SECRET_KEY=
LIFEOS_STRIPE_WEBHOOK_SECRET=
LIFEOS_STRIPE_PLUS_PRICE_ID=
LIFEOS_STRIPE_PRO_PRICE_ID=
# Development plan switch; never enable on a public production service.
LIFEOS_DEV_BILLING=0

# Optional recovery-key injection for headless/testing only. Normal users create/import
# the Recovery Key in LifeOS and store it via the local secret store.
LIFEOS_RECOVERY_KEY=
