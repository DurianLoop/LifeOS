{
  "name": "lifeos-desktop",
  "private": true,
  "version": "0.5.2",
  "description": "LifeOS private journal with poetry, ambient sounds and letters to the future",
  "author": "LifeOS Contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "node setup.cjs start",
    "test": "node --test startup.test.cjs setup.test.cjs pet-window.test.cjs reliability.test.cjs bottle-reminders.test.cjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:all": "electron-builder -mwl",
    "setup": "node setup.cjs setup --no-launch"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "life.lifeos.desktop",
    "productName": "LifeOS",
    "electronVersion": "37.10.3",
    "asar": true,
    "compression": "maximum",
    "files": [
      "*.cjs",
      "*.html",
      "package.json",
      "!*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!assets/pet-readme-previews/**"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../importers",
        "to": "importers",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../connectors",
        "to": "connectors",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python"
      },
      {
        "from": "../marketplace",
        "to": "marketplace"
      },
      {
        "from": "server_bootstrap.py",
        "to": "server_bootstrap.py"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "DurianLoop",
      "repo": "LifeOS"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LifeOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle",
      "artifactName": "LifeOS-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "为未来的自己录制漂流瓶语音",
        "NSCameraUsageDescription": "为未来的自己录制漂流瓶视频"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
