{
  "name": "lifeos-v0.1-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "LifeOS V0.1 local-first private journal desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "appId": "life.lifeos.desktop",
    "productName": "LifeOS",
    "electronVersion": "37.10.3",
    "asar": false,
    "files": [
      "**/*",
      "!python-runtime/**",
      "!server-dist/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app"
      },
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../engine",
        "to": "engine"
      },
      {
        "from": "../importers",
        "to": "importers"
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../vault",
        "to": "vault"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../connectors",
        "to": "connectors"
      },
      {
        "from": "python-runtime",
        "to": "python"
      },
      {
        "from": "../marketplace",
        "to": "marketplace"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
