{
  "name": "lifeos-v0.2.2-desktop",
  "private": true,
  "version": "0.2.2",
  "author": "LifeOS Contributors",
  "description": "LifeOS v0.2.2 local-first journal desktop app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "life.lifeos.desktop",
    "productName": "LifeOS",
    "electronVersion": "37.10.3",
    "asar": true,
    "compression": "maximum",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "!.electron-cache/**",
      "!.builder-cache/**",
      "!python-runtime/**",
      "!server-dist/**",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app",
        "filter": [
          "**/*",
          "!assets/pet-readme-previews/**"
        ]
      },
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../engine",
        "to": "engine"
      },
      {
        "from": "../importers",
        "to": "importers"
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../vault",
        "to": "vault"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../connectors",
        "to": "connectors"
      },
      {
        "from": "python-runtime",
        "to": "python"
      },
      {
        "from": "../marketplace",
        "to": "marketplace"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
